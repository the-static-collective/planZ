{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-static-collective/planZ/schema/plan-record-v0.schema.json",
  "title": "planZ PlanRecord v0",
  "type": "object",
  "required": [
    "schema",
    "planId",
    "title",
    "source",
    "stage",
    "disposition",
    "remaining",
    "confidence"
  ],
  "properties": {
    "schema": {
      "const": "static-collective/planz-plan-record/v0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ownerRepo": {
      "type": [
        "string",
        "null"
      ]
    },
    "firstSeen": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "branch",
              "commit",
              "pr",
              "issue",
              "other"
            ]
          },
          "ref": {
            "type": "string"
          },
          "sha": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "promise": {
      "type": "object",
      "properties": {
        "intent": {
          "type": [
            "string",
            "null"
          ]
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "stage": {
      "enum": [
        "TRACE",
        "IDEA",
        "DESIGN",
        "IMPLEMENTATION_PLAN",
        "IMPLEMENTING",
        "TESTED",
        "WITNESSED",
        "UNKNOWN"
      ]
    },
    "disposition": {
      "enum": [
        "LANDED",
        "STRANDED",
        "PARTIAL",
        "REINCARNATED",
        "SUPERSEDED",
        "HELD",
        "ABANDONED",
        "UNKNOWN"
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "implementationRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "descendantRefs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "negativeSearches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "remaining": {
      "type": "object",
      "required": [
        "summary"
      ],
      "properties": {
        "summary": {
          "type": "string"
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nextGate": {
          "type": [
            "string",
            "null"
          ]
        },
        "recoveryMode": {
          "enum": [
            "NONE",
            "RESURRECT",
            "REPORT",
            "RECOMPOSE",
            "INVESTIGATE",
            "HOLD"
          ]
        }
      },
      "additionalProperties": false
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "target"
        ],
        "properties": {
          "type": {
            "enum": [
              "parent",
              "child",
              "supersedes",
              "superseded-by",
              "reincarnated-as",
              "implements",
              "implemented-by",
              "related"
            ]
          },
          "target": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "lastReviewed": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
